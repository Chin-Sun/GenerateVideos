# Copy to .env locally. Never commit credentials. Shell users: export these values explicitly.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DRAMA_PAID_CALLS_ENABLED=false
DRAMA_PAID_AUTHORIZATION_ID=
DRAMA_MAX_PAID_SUBMISSIONS=0
DRAMA_PPAPI_API_KEY=
DRAMA_PPAPI_BASE_URL=
DRAMA_DOWNLOAD_ALLOWED_HOSTS=[]
DRAMA_ALLOWED_USER_IDS=[]
DRAMA_ALLOWED_TENANT_IDS=[]
DRAMA_FEISHU_APP_ID=
DRAMA_FEISHU_APP_SECRET=
DRAMA_FEISHU_VERIFICATION_TOKEN=
DRAMA_FEISHU_ENCRYPT_KEY=
DRAMA_ALLOW_UNVERIFIED_PREVIEW=false
DRAMA_LOCAL_API_TOKEN=
DRAMA_LOCAL_TENANT_ID=
DRAMA_LOCAL_USER_ID=
DRAMA_LOCAL_CHAT_ID=
DRAMA_DEFAULT_ASPECT_RATIO=9:16
